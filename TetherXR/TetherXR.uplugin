{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.1.0",
	"FriendlyName": "TetherXR",
	"Description": "Renders VR Preview and -vr games into a Quest headset on macOS through Tether.",
	"Category": "Virtual Reality",
	"CreatedBy": "Tether contributors",
	"CreatedByURL": "https://github.com/GameBayoumy/tether",
	"DocsURL": "",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EnabledByDefault": true,
	"CanContainContent": false,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"SupportedTargetPlatforms": [
		"Mac"
	],
	"Modules": [
		{
			"Name": "TetherXR",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [
				"Mac"
			]
		}
	],
	"Plugins": [
		{
			"Name": "XRBase",
			"Enabled": true
		}
	]
}
